{
  "name": "@yummysource/duolingo-cli",
  "version": "1.0.4",
  "description": "Read-only Duolingo CLI, reusable Skill, API client, and MCP server",
  "author": {
    "name": "Daniel Schroeder",
    "url": "https://www.udondan.com/"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/udondan"
    }
  ],
  "homepage": "https://github.com/yummysource/duolingo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yummysource/duolingo.git"
  },
  "bugs": {
    "url": "https://github.com/yummysource/duolingo/issues"
  },
  "keywords": [
    "duolingo",
    "api",
    "cli",
    "skill",
    "mcp"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "duolingo-cli": "dist/cli.js",
    "duolingo-mcp": "dist/server.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./server": {
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.js.map",
    "skills/duolingo-learn/**",
    "docs/guides/**",
    "README.md",
    "README.zh-TW.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "cli": "node dist/cli.js",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"README*.md\" \"docs/**/*.md\" \"skills/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"README*.md\" \"docs/**/*.md\" \"skills/**/*.md\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.2",
    "@napi-rs/keyring": "^1.3.0",
    "axios": "^1.7.9",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@vitest/coverage-v8": "^3.1.1",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
